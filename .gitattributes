# Repository text normalization
* text=auto

.gitattributes text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.ps1 text eol=lf
*.iss text eol=lf
*.md text eol=lf
*.txt text eol=lf
CMakeLists.txt text eol=lf
VERSION text eol=lf

# Binary / generated payloads
*.exe binary
*.dll binary
*.sys binary
*.cat binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
